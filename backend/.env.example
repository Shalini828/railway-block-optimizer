# IR-ABPS Backend Environment Configuration
# Production requires a unique JWT_SECRET. APP_ENV=development permits a
# process-local secret for local development only.
APP_ENV=production
JWT_SECRET=
# Demo role login is disabled unless this is explicitly configured.
DEMO_PASSWORD=
TOKEN_TTL_MINUTES=480
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
RBAC_ENFORCE=true
ENFORCE_CONTROLLER_REVIEW=false

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=railway_block_planning
DB_USER=postgres
DB_PASSWORD=
